diff --git a/programs/pricing-programs/flat-fee/src/processor/set_lp_withdrawal_fee.rs b/programs/pricing-programs/flat-fee/src/processor/set_lp_withdrawal_fee.rs
index cbb0f17f..95fd584c 100644
