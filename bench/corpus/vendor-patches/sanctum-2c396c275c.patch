From ecdc09d3dd326ac5d82d0e9c4e02528c426da048 Mon Sep 17 00:00:00 2001
From: "Jesse Y. Cho" <jessecho@cs.washington.edu>
Date: Wed, 31 Jan 2024 13:49:19 +0900
Subject: [PATCH 1/4] fee bound check for unsigned fee

---
 .../flat_fee_interface/src/errors.rs                 |  6 ++++--
 idl/pricing-programs/flat_fee.json                   |  7 ++++++-
 libs/pricing-programs/flat-fee-lib/src/fee_bound.rs  | 12 ++++++++++--
 3 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/generated/pricing-programs/flat_fee_interface/src/errors.rs b/generated/pricing-programs/flat_fee_interface/src/errors.rs
index 6e352393..bf455b3a 100644
--- a/generated/pricing-programs/flat_fee_interface/src/errors.rs
+++ b/generated/pricing-programs/flat_fee_interface/src/errors.rs
@@ -12,10 +12,12 @@ pub enum FlatFeeError {
     IncorrectProgramState = 1,
     #[error("FeeAccount is not initialized for the given LST mint")]
     UnsupportedLstMint = 2,
-    #[error("Given fee value is out of bound")]
+    #[error("Given signed fee value is out of bound")]
     SignedFeeOutOfBound = 3,
+    #[error("Given unsigned fee value is out of bound")]
+    UnsignedFeeOutOfBound = 4,
     #[error("Math error")]
-    MathError = 4,
+    MathError = 5,
 }
 impl From<FlatFeeError> for ProgramError {
     fn from(e: FlatFeeError) -> Self {
diff --git a/idl/pricing-programs/flat_fee.json b/idl/pricing-programs/flat_fee.json
index 72a06ea0..bd3195c1 100644
--- a/idl/pricing-programs/flat_fee.json
+++ b/idl/pricing-programs/flat_fee.json
@@ -421,10 +421,15 @@
     {
       "code": 3,
       "name": "SignedFeeOutOfBound",
-      "msg": "Given fee value is out of bound"
+      "msg": "Given signed fee value is out of bound"
     },
     {
       "code": 4,
+      "name": "UnsignedFeeOutOfBound",
+      "msg": "Given unsigned fee value is out of bound"
+    },
+    {
+      "code": 5,
       "name": "MathError",
       "msg": "Math error"
     }
diff --git a/libs/pricing-programs/flat-fee-lib/src/fee_bound.rs b/libs/pricing-programs/flat-fee-lib/src/fee_bound.rs
index 98c01a0d..442a5718 100644
--- a/libs/pricing-programs/flat-fee-lib/src/fee_bound.rs
+++ b/libs/pricing-programs/flat-fee-lib/src/fee_bound.rs
@@ -1,10 +1,18 @@
 use flat_fee_interface::FlatFeeError;
 
-const MAX_FEE_BPS: i16 = 10_000;
+const MAX_SIGNED_FEE_BPS: i16 = 10_000;
+const MAX_UNSIGNED_FEE_BPS: u16 = 10_000;
 
 pub fn verify_signed_fee_bps_bound(fee_bps_i16: i16) -> Result<(), FlatFeeError> {
-    if !(-MAX_FEE_BPS..=MAX_FEE_BPS).contains(&fee_bps_i16) {
+    if !(-MAX_SIGNED_FEE_BPS..=MAX_SIGNED_FEE_BPS).contains(&fee_bps_i16) {
         return Err(FlatFeeError::SignedFeeOutOfBound);
     }
     Ok(())
 }
+
+pub fn verify_unsigned_fee_bps_bound(fee_bps_u16: u16) -> Result<(), FlatFeeError> {
+    if !(0..=MAX_UNSIGNED_FEE_BPS).contains(&fee_bps_u16) {
+        return Err(FlatFeeError::UnsignedFeeOutOfBound);
+    }
+    Ok(())
+}

From 57eb9422b4521e1da1de155812052ce176f9d7a5 Mon Sep 17 00:00:00 2001
